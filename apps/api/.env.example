# Copy to .env (gitignored) for local dev: npm run dev
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=...
# Only this Supabase account's email can load GET /api/analytics/summary —
# everyone else gets 403, and if this is unset the route 500s for everyone.
ANALYTICS_OWNER_EMAIL=you@example.com
APP_URL=http://localhost:5173
PORT=8080
