# Copy to .env.local (already gitignored) and fill in real values.
# Everything here is a build-time PUBLIC value — never put a secret key in
# a VITE_ variable, it ships straight into the browser bundle.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Base URL of the apps/api Azure Functions app. Local dev default matches
# `func start`'s default port.
VITE_API_URL=http://localhost:7071
