# Copy to .env.local (already gitignored) and fill in real values.
# Everything here is a build-time PUBLIC value — never put a secret key in
# a VITE_ variable, it ships straight into the browser bundle.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Base URL of apps/api (a plain Express app, not Azure Functions — see
# root README). Local dev default matches its own `PORT ?? 8080` fallback.
VITE_API_URL=http://localhost:8080
