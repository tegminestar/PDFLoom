        <!-- Well-Architected Framework legend -->
        <mxCell id="legend-title" value="Well-Architected Framework — pillars applied" style="text;html=1;align=left;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1320" y="270" width="340" height="24" as="geometry" />
        </mxCell>
        <mxCell id="pillar-reliability" value="&lt;b&gt;RELIABILITY&lt;/b&gt;&lt;br&gt;Multi-region active/active or active/passive&lt;br&gt;Automated failover, health probes&lt;br&gt;Tested backup/restore, defined RPO/RTO" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1320" y="300" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="pillar-security" value="&lt;b&gt;SECURITY&lt;/b&gt;&lt;br&gt;WAF + DDoS protection at the edge&lt;br&gt;Private networking, least-privilege IAM&lt;br&gt;Centralized secrets; encryption in transit &amp;amp; at rest" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1320" y="412" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="pillar-performance" value="&lt;b&gt;PERFORMANCE EFFICIENCY&lt;/b&gt;&lt;br&gt;CDN edge caching + regional read replicas&lt;br&gt;Auto-scaling compute per region&lt;br&gt;Async processing for heavy workloads" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1320" y="524" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="pillar-cost" value="&lt;b&gt;COST OPTIMIZATION&lt;/b&gt;&lt;br&gt;Scale-to-zero where workload allows&lt;br&gt;Reserved capacity for steady baseline&lt;br&gt;Storage tiering, right-sized instances" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1320" y="636" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="pillar-operational" value="&lt;b&gt;OPERATIONAL EXCELLENCE&lt;/b&gt;&lt;br&gt;Infrastructure as Code&lt;br&gt;CI/CD with progressive delivery&lt;br&gt;Centralized observability, on-call alerting" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
