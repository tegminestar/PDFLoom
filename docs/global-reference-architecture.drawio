        <mxCell id="subtitle" value="Illustrative target-state design for worldwide, multi-region deployment — vendor-neutral roles, mappable to any major cloud (Azure / AWS / GCP)" style="text;html=1;align=left;fontSize=11;fontColor=#666666;fontStyle=2;" vertex="1" parent="1">
